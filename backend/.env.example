# backend/.env.example — คัดลอกเป็น backend/.env แล้วเติมค่า (อย่า commit .env)
# คีย์ครบตามที่โค้ด backend อ่านจริง (os.getenv) ค่า secret ปล่อยว่างไว้

# ── Secrets / API keys (ใส่ของจริง ห้าม commit) ──
TELEGRAM_TOKEN=
ANTHROPIC_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
NEWS_API_KEY=
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# ── Infra ──
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ai_trading
REDIS_URL=redis://localhost:6379/0

# ── Mode ──
PAPER_MODE=true            # true = ไม่ส่งออเดอร์จริง (paper broker)

# ── MT5 bridge (Roadmap ข้อ 1 / Option A) ──
# กฎเหล็ก: 2 เครื่องต้องอยู่ git commit เดียวกัน + ค่าพวกนี้ตรงกัน
# PC (Windows+MT5) รัน bridge ดูทอง; Mac ชี้มาที่ bridge ของ PC เพื่อใช้ราคาทอง MT5 จริง
# PC ปิดเมื่อไหร่ Mac fallback ไป Binance อัตโนมัติ
MT5_BRIDGE_URL=http://localhost:8765   # Mac: เปลี่ยนเป็น http://<PC-IP>:8765
MT5_SYMBOL_SUFFIX=m                     # Exness ใช้ suffix m (XAUUSDm -> XAUUSD)
# MT5_BRIDGE_KEY=                       # (optional) X-API-Key ถ้า bridge ตั้ง auth ไว้
# MT5_BRIDGE_POLL_SECONDS=1.0           # (optional) รอบ poll ticks

# ── ERP integration (optional) ──
# ERP_WEBHOOK_URL=http://localhost:5001/webhook/trade-event
# ERP_API_KEY=
# ERP_WEBHOOK_SECRET=

# ── Tuning (optional — มี default ในโค้ด) ──
# STARTING_BALANCE=45750
# YAHOO_POLL_SECONDS=12
# BINANCE_GOLD_POLL_SECONDS=5
