PORT=5001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@127.0.0.1:5432/ai_trading
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# Redis
